{
  // The page is a static export served from Cloudflare's edge. One small
  // Worker (worker/index.ts) answers /api/enquiry; every other path goes
  // straight to the static files without running any code.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crystal-kizor",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
