{
  // Static export plus one Worker route; see worker/index.ts.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crystal-kizor",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Durable per-IP limit for the enquiry form: 2 messages a minute.
  "ratelimits": [
    { "name": "ENQUIRY_LIMITER", "namespace_id": "2601", "simple": { "limit": 2, "period": 60 } }
  ]
}
