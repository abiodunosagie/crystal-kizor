{
  // Static site served straight from Cloudflare's edge. There is no Worker
  // script: `npm run build` writes plain files to ./out and they are uploaded
  // as static assets.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crystal-kizor",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
